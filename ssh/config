# SSH config — symlinked to ~/.ssh/config by install.sh
#
# Keys are NEVER stored in this repo. Generate them per-machine:
#
#   ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_personal  -C "tom.hendra@outlook.com"
#   ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa_silicondali -C "thomas.hendra@silicondali.com"
#
# NOTE: the work key is RSA, not ed25519 — Azure DevOps only accepts RSA keys
# ("invalid keys will start with ssh-rsa"). GitHub accepts either; the work key
# is shared across both so it has to be RSA.
#
# Then add each .pub to the relevant host:
#   personal    -> https://github.com/settings/keys
#   silicondali -> https://github.com/settings/keys (work account)
#                  https://dev.azure.com/SiliconDali/_usersSettings/keys

Host *
  PreferredAuthentications publickey
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes

# Personal GitHub — tomhendra/*
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal

# Client GitHub — amar-technologies/*, SiliconDali/*
# Clone with: git@github-silicondali:SiliconDali/repo.git
Host github-silicondali
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_rsa_silicondali

# Azure DevOps — SiliconDali/{Libertex,BetXchange}
# ADO requires RSA for both the client key and the host key algorithms.
# Without the two algorithm lines, modern OpenSSH refuses ADO's ssh-rsa host
# key and fails with a misleading "permission denied".
Host ssh.dev.azure.com
  HostName ssh.dev.azure.com
  User git
  IdentityFile ~/.ssh/id_rsa_silicondali
  HostkeyAlgorithms +ssh-rsa
  PubkeyAcceptedAlgorithms +ssh-rsa
